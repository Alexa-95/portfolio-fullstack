{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-contact",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "send_email": [
    {
      "name": "EMAIL",
      "remote": true,
    },
  ],
}
